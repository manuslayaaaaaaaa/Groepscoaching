<div id="faq-section-{{ section.id }}" class="faq-custom-wrapper">

  <h2 class="faq-custom-title">{{ section.settings.heading }}</h2>

  <div class="faq-custom-list">
    {% for block in section.blocks %}
      <div class="faq-custom-item">
        
        <button class="faq-custom-trigger">
          <span class="faq-custom-question-text">
            {{ block.settings.title }}
          </span>
          <span class="faq-custom-arrow"></span>
        </button>

        <div class="faq-custom-content">
          <div class="faq-custom-answer">
            {{ block.settings.text }}
          </div>
        </div>

      </div>
    {% endfor %}
  </div>

</div>

<style>
#faq-section-{{ section.id }} {
  font-family: "Montserrat", sans-serif;
  padding-left: 16px;
  padding-right: 16px;
}

/* TITLE */
#faq-section-{{ section.id }} .faq-custom-title {
  font-size: 32px;
  font-weight: 400;
  text-align: center;
  margin-bottom: 16px;
}

/* LIST */
.faq-custom-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* BLOCK */
.faq-custom-trigger {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 18px;
  background: #f7f7f7;
  border: none;
  border-radius: 10px;
  cursor: pointer;
}

/* HOVER (instant, no fade) */
.faq-custom-trigger:hover .faq-custom-question-text {
  color: #ededed;
}

/* TEXT */
.faq-custom-question-text {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #000;
}

/* ARROW */
.faq-custom-arrow {
  width: 8px;
  height: 8px;
  border-top: 2px solid #000;
  border-right: 2px solid #000;
  transform: rotate(45deg);
  transition: transform 0.25s ease;
}

/* OPEN STATE */
.faq-custom-trigger.active .faq-custom-arrow {
  transform: rotate(135deg);
}

/* CONTENT */
.faq-custom-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}

.faq-custom-content.open {
  max-height: 300px;
}

.faq-custom-answer {
  padding: 12px 18px;
  font-size: 13px;
  line-height: 1.6;
}
</style>

<script>
document.querySelectorAll("#faq-section-{{ section.id }} .faq-custom-trigger").forEach(btn => {
  btn.addEventListener("click", () => {
    const content = btn.nextElementSibling;

    btn.classList.toggle("active");
    content.classList.toggle("open");
  });
});
</script>