{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

<div class="page-width page-width--narrow faq-custom-section" id="faq-section-{{ section.id }}">

  {%- if section.settings.title != blank -%}
    <header class="section-header faq-custom-header">
      <h2 class="section-header__title faq-custom-title">
        {{ section.settings.title | escape }}
      </h2>
    </header>
  {%- endif -%}

  <div class="faq-custom-list">
    {%- for block in section.blocks -%}
      <div class="faq-custom-item" {{ block.shopify_attributes }}>

        <button
          type="button"
          class="collapsible-trigger faq-custom-trigger"
          aria-controls="FAQ-content-{{ block.id }}"
          aria-expanded="false"
        >
          <span class="faq-custom-question-text">{{ block.settings.title }}</span>
          <span class="faq-custom-arrow"></span>
        </button>

        <div id="FAQ-content-{{ block.id }}" class="collapsible-content faq-custom-content">
          <div class="faq-custom-answer">
            {{ block.settings.text }}
          </div>
        </div>

      </div>
    {%- endfor -%}
  </div>

</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

<style>
#faq-section-{{ section.id }} {
  font-family: "Montserrat", sans-serif;
}

/* TITLE */
#faq-section-{{ section.id }} .faq-custom-title {
  font-size: 32px !important;
  font-weight: 400 !important;
  text-align: center;
  margin-bottom: 12px;
}

/* LIST */
#faq-section-{{ section.id }} .faq-custom-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

/* ITEM */
#faq-section-{{ section.id }} .faq-custom-trigger {
  width: 100%;
  display: flex !important;
  align-items: center !important;
  justify-content: space-between !important;

  padding: 13px 20px !important;
  min-height: 52px;

  border-radius: 10px !important;
  border: none !important;

  background: #f7f7f7 !important;
  color: #000 !important;

  transition: none !important;
}

/* HOVER = alleen tekst */
#faq-section-{{ section.id }} .faq-custom-trigger:hover {
  background: #f7f7f7 !important;
}

#faq-section-{{ section.id }} .faq-custom-trigger:hover .faq-custom-question-text {
  color: #ededed !important;
}

/* TEXT */
#faq-section-{{ section.id }} .faq-custom-question-text {
  font-size: 15px !important;
  font-weight: 450 !important;
  letter-spacing: 0.18em !important;
  text-transform: uppercase !important;

  color: #000 !important;

  transition: none !important;
}

/* OUDE ICONEN WEG */
#faq-section-{{ section.id }} svg,
#faq-section-{{ section.id }} .icon {
  display: none !important;
}

/* ARROW */
#faq-section-{{ section.id }} .faq-custom-arrow {
  width: 9px;
  height: 9px;

  border-top: 2px solid #000;
  border-right: 2px solid #000;

  transform: rotate(45deg);
  transition: transform 0.2s ease;
}

/* OPEN STATE */
#faq-section-{{ section.id }} .faq-custom-trigger.is-open .faq-custom-arrow {
  transform: rotate(135deg);
}

/* ANSWER */
#faq-section-{{ section.id }} .faq-custom-answer {
  padding: 12px 20px 4px;
  font-size: 15px;
  line-height: 1.6;
  color: #000;
}

/* MOBILE */
@media (max-width: 768px) {
  #faq-section-{{ section.id }} .faq-custom-trigger {
    padding: 13px 20px !important;
    min-height: 52px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const section = document.querySelector('#faq-section-{{ section.id }}');
  if (!section) return;

  const triggers = section.querySelectorAll('.faq-custom-trigger');

  triggers.forEach(trigger => {
    trigger.addEventListener('click', function () {
      const content = document.getElementById(trigger.getAttribute('aria-controls'));
      const isOpen = trigger.classList.contains('is-open');

      /* close all */
      triggers.forEach(t => {
        t.classList.remove('is-open');
        t.setAttribute('aria-expanded', 'false');
        const c = document.getElementById(t.getAttribute('aria-controls'));
        if (c) c.style.display = 'none';
      });

      /* open current */
      if (!isOpen) {
        trigger.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
        if (content) content.style.display = 'block';
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "FAQs",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "Your question"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Answer",
          "default": "<p>Your answer here</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ"
    }
  ]
}
{% endschema %}