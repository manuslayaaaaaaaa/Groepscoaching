<style>
.reviews_stars{
  display:flex;
  align-items:center;
  gap:6px;
  text-decoration:none;
  color:#000000;
  margin-bottom:10px;
}

@media screen and (max-width:749px){
  .reviews_stars{margin-top:-25px;}
}

.reviews_stars .stars{
  position:relative;
  display:inline-block;
  line-height:1;
  font-size:16px;
  letter-spacing:-1px;
  color:#cccccc;
  width:max-content;
  transform:translateY(-1px);
}

.reviews_stars .stars-base,
.reviews_stars .stars-fill{
  display:block;
  white-space:nowrap;
  font-family:Arial,sans-serif;
}

.reviews_stars .stars-fill{
  position:absolute;
  left:0;
  top:0;
  overflow:hidden;
  color:#ffc502;
  width:0;
}

.reviews_stars .ratings span{
  white-space:nowrap;
  color:#000000;
  font-size:14px;
  font-family:Arial,sans-serif;
}
</style>

<a href="#aus-tp-slider" class="reviews_stars" {{ block.shopify_attributes }}>
  <div class="stars" data-rating="{{ block.settings.tp_rating }}">
    <span class="stars-base">★★★★★</span>
    <span class="stars-fill">★★★★★</span>
  </div>
  <div class="ratings">
    <span>{{ block.settings.review_text | replace: '[rating]', block.settings.tp_rating | replace: '[reviews]', block.settings.tp_reviews }}</span>
  </div>
</a>

<script>
(function(){
  const block = document.currentScript.previousElementSibling;
  if(!block) return;

  const stars = block.querySelector('.stars');
  const fill = block.querySelector('.stars-fill');

  if(!stars || !fill) return;

  let rating = parseFloat(stars.dataset.rating || '0');
  if(isNaN(rating)) rating = 0;

  rating = Math.max(0, Math.min(5, rating));

  fill.style.width = (rating / 5 * 100) + '%';
})();
</script>
